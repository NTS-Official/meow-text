{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "meow-text",
  "version": "0.1.0",
  "identifier": "dev.meowtext.desktop",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "meow-text · 喵化控制面板",
        "width": 960,
        "height": 800,
        "minWidth": 780,
        "minHeight": 560,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}